---
import type { Translations } from '@bonae/content';
import type { TemplateItem } from '../lib/templates';
import { templatesSectionHref } from '../lib/templates';

interface Props {
  t: Translations;
  item: TemplateItem;
  whatsappHref: string;
}

const { t, item, whatsappHref } = Astro.props;
const section = t.templates;
const backHref = templatesSectionHref(t.lang);
const demoUrl = item.demoUrl.trim();
const priceLabel = `${section.priceCurrency} ${item.price}`;
---

<section class="flex-1 bg-cream py-10 md:py-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 text-sm font-semibold text-body hover:text-dark-blue transition-colors mb-8"
    >
      {section.backLabel}
    </a>

    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14 items-start">
      <div class="rounded-2xl overflow-hidden shadow-lg bg-dark-blue border border-light-blue/15">
        <img
          src={item.imageSrc}
          alt=""
          class="w-full object-cover object-top aspect-[4/3]"
          width="800"
          height="600"
        />
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-terracotta mb-3">{item.category}</p>
        <h1 class="text-3xl md:text-4xl font-bold text-dark-blue mb-4 leading-tight">{item.title}</h1>
        <p class="text-base text-body leading-relaxed mb-8">{item.detailDescription}</p>

        {item.features.length > 0 && (
          <div class="rounded-2xl bg-white border border-light-blue/15 shadow-sm px-6 py-5 mb-8">
            <h2 class="text-base font-bold text-dark-blue mb-4">{section.featuresLabel}</h2>
            <ul class="space-y-3">
              {item.features.map((feature) => (
                <li class="flex gap-3 items-start">
                  <span class="w-2 h-2 rounded-full bg-terracotta shrink-0 mt-2" aria-hidden="true"></span>
                  <span class="text-sm text-body leading-relaxed">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="flex items-baseline gap-2 mb-6">
          <p class="text-3xl font-bold text-dark-blue">{priceLabel}</p>
          <p class="text-sm text-body">{section.priceNote}</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg bg-terracotta text-white font-semibold hover:bg-terracotta-dark transition-colors"
          >
            {section.useTemplateLabel}
          </a>
          {demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg border-2 border-dark-blue text-dark-blue font-semibold hover:bg-dark-blue hover:text-white transition-colors"
            >
              {section.demoLabel}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
