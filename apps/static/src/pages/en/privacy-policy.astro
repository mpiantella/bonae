---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LegalPage from '../../components/LegalPage.astro';
import { publishedEn, siteSettings, whatsappHrefFor } from '../../lib/content';

const t = publishedEn;
const whatsappHref = whatsappHrefFor(t);
const pageTitle = `Privacy Policy — ${t.siteName}`;
const pageDescription =
  'Bonae Tech privacy policy: how we collect, use, and protect your personal information.';
---

<Layout
  t={t}
  settings={siteSettings}
  whatsappHref={whatsappHref}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
>
  <Header t={t} />
  <main class="flex-1 flex flex-col">
    <LegalPage title="Privacy Policy" updatedLabel="Last updated: July 2026">
      <p>
        At Bonae Tech, we value and respect the privacy of users, clients, and visitors to our website
        and digital services. This privacy policy describes how we collect, use, store, and protect the
        personal information you provide when interacting with our platform.
      </p>
      <p>
        By using our services and browsing our website, you accept the practices described in this
        policy, in accordance with the constitutional principle of Habeas Data and the information
        protection regulations applicable in Venezuela and Latin America.
      </p>

      <h2>1. Information we collect</h2>
      <p>We may collect the following personal data:</p>
      <ul>
        <li>
          <strong>Information provided directly:</strong> First name, last name, email address, phone
          number, company name, job title, and project details shared through contact forms, quote
          requests, or support channels.
        </li>
        <li>
          <strong>Information collected automatically:</strong> IP address, browser type, operating
          system, pages visited, time spent on the site, and browsing data through cookies or similar
          technologies.
        </li>
      </ul>

      <h2>2. Purpose of data processing</h2>
      <p>Personal data collected is processed for the following purposes:</p>
      <ul>
        <li>Respond to information requests, quotes, and technology advisory inquiries.</li>
        <li>
          Provide, deliver, and manage contracted development, consulting, or technology project
          services.
        </li>
        <li>
          Send administrative communications, service updates, or responses to inquiries.
        </li>
        <li>
          Send promotional material, newsletters, or technology updates (only when the user has
          expressly authorized it).
        </li>
        <li>
          Improve navigation, security, and the user experience on our web platform.
        </li>
      </ul>

      <h2>3. Confidentiality and information security</h2>
      <p>
        We are committed to applying technical, organizational, and administrative security measures
        aimed at preventing unauthorized access, loss, alteration, or improper disclosure of your data.
        Authorized Bonae Tech personnel and collaborators are subject to strict confidentiality
        obligations.
      </p>

      <h2>4. Transfer of data to third parties</h2>
      <p>
        Bonae Tech does not sell, rent, or commercialize personal data to third parties. We will only
        share information when:
      </p>
      <ul>
        <li>
          It is required by infrastructure providers or technology tools necessary to deliver our
          services (under appropriate confidentiality agreements).
        </li>
        <li>
          It is required by a court order, request from a competent authority, or a legally grounded
          legal mandate.
        </li>
      </ul>

      <h2>5. ARCO rights (Access, Rectification, Cancellation, and Opposition)</h2>
      <p>In accordance with regional privacy regulations, you have the right to:</p>
      <ul>
        <li>Access the personal data we hold about you.</li>
        <li>Rectify any inaccurate or outdated information.</li>
        <li>
          Request deletion/cancellation of your data when it is no longer necessary for the contracted
          purposes.
        </li>
        <li>
          Object to receiving commercial communications or to processing for specific purposes.
        </li>
      </ul>
      <p>
        To exercise any of these rights, you may send a request to our contact email:
        {' '}
        <a href="mailto:bonaetech@gmail.com">bonaetech@gmail.com</a>
      </p>
    </LegalPage>
  </main>
  <Footer t={t} settings={siteSettings} whatsappHref={whatsappHref} />
</Layout>
